# Content source: "mdx" (default, file-based) or "wordpress"
CMS_CLIENT=mdx

# Required when CMS_CLIENT=wordpress — the WP site base URL (no trailing /wp-json)
# WORDPRESS_API_URL=http://localhost:8080   # the local server/ backend (cd server && docker compose up)

# Absolute site URL — used by metadataBase, sitemap.ts, robots.ts
SITE_URL=http://localhost:3000

# Shared secret for an on-demand revalidation webhook (optional)
# REVALIDATE_SECRET=change-me
